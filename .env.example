# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values; .env is gitignored.

# Postgres. Only needed if you are NOT using the Supabase marketplace
# integration — that injects POSTGRES_URL (already the pooled 6543 endpoint)
# and the app reads it automatically. DATABASE_URL wins when both are set.
#
# MUST be a POOLED connection string:
#   Neon      → the host containing "-pooler"
#   Supabase  → port 6543 (the "Transaction" pooler), not 5432
# A direct connection will exhaust Postgres' connection limit under load,
# because every warm serverless instance opens its own pool.
DATABASE_URL=

# Resend (https://resend.com) — order confirmation + notification email.
# Leave these unset and orders are still saved; the emails are just skipped
# and the failure is logged.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
ORDER_FROM_EMAIL=orders@yourdomain.com
# Where new-order and new-subscriber notifications are sent.
ORDER_NOTIFY_EMAIL=you@yourdomain.com
